# ─────────────────────────────────────────────────────────────
# Kizmet landing page — environment variables
# Copy to `.env.local` (git-ignored) and fill real values.
# Every var here is documented in docs/technical-spec.md §12.
# ─────────────────────────────────────────────────────────────

# --- Public (shipped to the browser) ---
# Canonical URL (OG tags, sitemap, robots, confirm links). Production: https://kizmetclubs.com
# (no trailing slash). Leave as localhost for local dev. In Vercel set it as a Config
# variable (not Sensitive) and redeploy — NEXT_PUBLIC_ values are baked in at build time.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Active design theme (see src/themes/registry.ts). "default" | "alt"
NEXT_PUBLIC_THEME="default"
# The in-person pilot Google Form (secondary CTA). Leave blank to hide the pilot link.
NEXT_PUBLIC_PILOT_FORM_URL=""
# Umami cookieless analytics (added in M4). Leave blank to disable.
NEXT_PUBLIC_UMAMI_SRC=""
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""

# --- Server only (NEVER exposed to the browser) — added in M2/M3 ---
# Supabase (EU / Frankfurt)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# Resend transactional email (double opt-in)
RESEND_API_KEY=""
# From address for the confirmation email; must be on a domain verified in Resend.
# Production: "Nearfolk <hello@kizmetclubs.com>". Defaults to Resend's onboarding@resend.dev
# (test only) if unset.
RESEND_FROM=""
# Double opt-in stays OFF until kizmetclubs.com is verified in Resend (SPF/DKIM).
WAITLIST_DOUBLE_OPTIN="false"
# Rate limiting (optional; Postgres-counter fallback used if unset)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
